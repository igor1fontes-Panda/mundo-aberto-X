// Detalhes proximidade Jogador
let perto = W.agentes.find(a => a.vivo && Math.abs(a.x - W.jogador.x) < 2 && Math.abs(a.y - W.jogador.y) < 2);
const info = document.getElementById("nearinfo");
if(perto){
info.innerHTML = Perto de: <b class="phi">${perto.nome}</b> (${perto.profissao}) | Fome: ${Math.floor(perto.fome)}% | Moedas: ${perto.moedas}🪙;
} else {
info.innerText = "Nenhum agente por perto.";
