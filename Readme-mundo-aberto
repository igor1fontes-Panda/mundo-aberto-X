const FRASES={
 saudacao:["eu","lume","tu"], fome:["eu","querer","comida"], sede:["eu","querer","agua"],
 trabalho:["eu","trabalho","futuro"], obrigado:["eu","obrigado","tu","dar"],
 ajuda:["tu","ajuda","eu","perigo"], troca:["eu","trocar","ferramenta","moeda"],
 ensinar:["eu","ensinar","saber","escola"], amizade:["tu","amizade","eu","sonho"],
 preocupacao:["fundo","perigo","fome"], criar:["eu","criar","casa","lume"],
