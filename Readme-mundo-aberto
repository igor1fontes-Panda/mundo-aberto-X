 SEEDS.forEach(s=>{W.lume.markov[s]={}; SEEDS.forEach(s2=>W.lume.markov[s2][s]=1);});
 CONCEITOS.forEach((c,i)=>{
  W.lume.dict[c] = W.lume.dict[c] || (SEEDS[i % SEEDS.length] + (i >= SEEDS.length ? SEEDS[ri(0,SEEDS.length-1)] : ""));
 });
 
 W.agentes.push(...Array.from({length:8},()=>novoAgente(12+rnd(-4,4),12+rnd(-4,4),true)));
 for(let i=0;i<4;i++)novaFauna();
 log("🌍 <b>Mundo Aberto X</b> iniciado — 8 agentes, distrito <b>Lume Prime</b>, sementes Lume configuradas.","sys");
 return W;
}

function novoAgente(x,y,adulto,genes,pais){
 const id = W.proxId++;
 const g = genes || {f:rnd(.2,.9),i:rnd(.2,.9),s:rnd(.3,.9)}; // fome_taxa, inteligencia, sociabilidade
 const n = pick(["Aura","Lumen","Fibo","Sora","Kael","Eon","Lyra","Tael","Zion","Nova"])+" "+fib(ri(3,10));
 return {
  id, nome:n, x, y, idade: adulto?ri(18,35):0, fome:0, saude:100, moedas:ri(10,50),
  genes:g, profissao:pick(["Coletor","Artesão","Filósofo","Construtor"]), vivo:true,
  conhecimento: ri(5,20), palavraFavorita: pick(SEEDS)
 };
}

function novaFauna(){
 W.fauna.push({
  id: W.proxId++,
  tipo: pick(["Eco-Lince","Pássaro-Fibonacci","Sombra-Mansa"]),
  x: ri(2,22), y: ri(2,22), energia: 100, viva: true
 });
}

function traduzirLume(conceitoArray){
 return conceitoArray.map(c => W.lume.dict[c] || "??").join(" ");
}

/* ================= MOTOR / LOOP DE SIMULAÇÃO ================= */
function tick(){
 W.tick++;
 W.jogador.x = clamp(W.jogador.x + W.jogador.dx, 0, 24);
 W.jogador.y = clamp(W.jogador.y + W.jogador.dy, 0, 24);
 W.jogador.dx = 0; W.jogador.dy = 0;

 let fomeSoma = 0;
 W.agentes.forEach(a => {
  if(!a.vivo) return;
  a.idade += 0.05;
  a.fome = clamp(a.fome + a.genes.f * 1.5, 0, 100);
  fomeSoma += a.fome;

  // Movimento aleatório guiado pela proporção Áurea
  if(Math.random() < AUR){
   a.x = clamp(a.x + rnd(-1.5,1.5), 0, 24);
   a.y = clamp(a.y + rnd(-1.5,1.5), 0, 24);
  }

  // Lógica de Sobrevivência Básica
  if(a.fome > 75 && a.moedas >= W.market?.comida?.p){
   a.moedas -= 2; a.fome = Math.max(0, a.fome - 40);
  }
Use o código com cuidado.
if(a.fome >= 100) a.saude = clamp(a.saude - 5, 0, 100);
if(a.saude <= 0){ a.vivo = false; W.mortes++; log(💀 O agente <b>${a.nome}</b> sucumbiu à mortalidade., "sistema"); }
// Interação e Evolução do Lume
if(Math.random() < 0.1 && W.agentes.length > 1){
let outro = pick(W.agentes);
if(outro.id !== a.id && outro.vivo && Math.abs(a.x - outro.x) < 4){
W.lume.conversas++;
let chaveFrase = pick(Object.keys(FRASES));
let t = traduzirLume(FRASES[chaveFrase]);
if(W.tick % 20 === 0) log(🗣️ <b>${a.nome}</b> para <b>${outro.nome}</b>: "${t}" (${chaveFrase}), "lume");
}
}
});
// Atualização Fauna
W.fauna.forEach(f => { if(f.viva) { f.x = clamp(f.x+rnd(-1,1),0,24); f.y = clamp(f.y+rnd(-1,1),0,24); } });
updateUI(fomeSoma);
renderMap();
}
/* ================= INTERFACE E RENDERIZAÇÃO ================= */
