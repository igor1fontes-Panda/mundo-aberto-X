 l.innerHTML = `<div class="logline"><small>[${d}] [${cat.toUpperCase()}]</small> ${msg}</div>` + l.innerHTML;
}

function novoMundo(){
 W={v:1,tick:0,proxId:1,nextCrit:1,round:1,gauntlets:0,nascimentos:0,mortes:0,
  mercado:{comida:{q:30,p:2},madeira:{q:20,p:3},pedra:{q:15,p:4},ferramenta:{q:6,p:12},arte:{q:4,p:8}},
  fundo:{moedas:400,instituicoes:[],fila:["Escola","Hospital","Academia","Mercado Grande","Hospedaria","Farol"],ultimaConstrucao:-99,anexos:0},
  distritoN:1,agentes:[],fauna:[],lume:{dict:{},markov:{},salto:1,conversas:0},
  jogador:{x:12,y:12,moedas:120,ferramentas:0,itens:[],dx:0,dy:0},
