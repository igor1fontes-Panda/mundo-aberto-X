{
  "name": "mundo-aberto-x",
  "version": "6.0.0",
  "private": true,
  "description": "Sociedade expansível de agentes AI: escola/academia, professores auto-aprendentes, código de conduta, mapa RPG com ruas, fauna, touch, língua Lume.",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build:local && node serve.js",
    "build:local": "esbuild app.js --loader:.js=jsx --jsx=transform --target=es2018 --outfile=app.compiled.js && node -e \"const fs=require('fs');fs.writeFileSync('mundo.js','window.WORLD='+fs.readFileSync('mundo.json','utf8')+';')\"",
    "test": "node engine.test.js"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
